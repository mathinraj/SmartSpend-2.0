{
  "expo": {
    "name": "SpendTrak",
    "slug": "spendtrak",
    "version": "1.8.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "spendtrak",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.mathinraj.spendtrak"
    },
    "android": {
      "package": "com.mathinraj.spendtrak",
      "versionCode": 9,
      "adaptiveIcon": {
        "backgroundColor": "#1C1245",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1C1245",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 72
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#6C5CE7",
          "icon": "./assets/images/notification-icon.png"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow SpendTrak to use Face ID to unlock the app."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SpendTrak to use a photo from your library as your profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true
          }
        }
      ],
      "./plugins/with-release-signing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
